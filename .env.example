# --- Database (Postgres) ---
# Use a dedicated DB per environment. In CI the test runner points this at an ephemeral DB.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/eclass

# --- Payload ---
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public root URL of the deployed app (used for links, invites, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags ---
# When true, E2E/acceptance tests are allowed to seed deterministic fixtures.
ALLOW_TEST_SEEDING=false

# --- Observability placeholders (filled in P6) ---
# Telemetry endpoint is intentionally absent in P0 — events must not be sent anywhere yet.
